# 卓品智能 AI 转型 — 环境变量样例（只列变量名，**不放任何真实值**）
# 真实凭据只写进 .env（已 gitignore，绝不提交）。复制本文件为 .env 后填值。

# ── U9C / ERP（OAuth2，唯一规范连接器 ZpConnector）──────────────────────────────
# ⚠️ base 用 host-only（不带 /U9C，连接器内部自拼 /U9C 与 /zp；带 /U9C 会 404）
U9C_API_BASE=            # 例 https://erp.equalitytec.com:4443
U9C_USER_CODE=
U9C_ENT_CODE=
U9C_ORG_CODE=
U9C_CLIENT_ID=
U9C_CLIENT_SECRET=
# 鉴权 = OAuth2(client_id/secret)，**不需要 admin 密码**（U9C_API_PASSWORD 已弃用）
# 数据源开关：mock（默认，CSV 回退）| real（无真实端点的方法 fail-loud，不静默回退 mock）
U9C_DATA_SOURCE=mock
# 过渡期 real 模式显式 opt-in 回退（非默认；结果非权威、禁入对客/L2）：1/true 开启
U9C_ALLOW_MOCK_FALLBACK=

# ── 库存实时源：卓品自建 /zp/api/Stock/Query（apiKey，vendor-independent；缺料/齐套/保供用）──
# get_inventory(material_ids) 走此接口取白名单仓真实可用量；apiKey 脱敏不入日志
STOCK_API_BASE=            # 例 http://192.168.100.49:6666（测试库）/ 生产 host
STOCK_API_KEY=            # /zp apiKey（与 FORECAST_API_KEY 同一 key）
# SC8 保供现货净额开关：on|off（默认 off=零漂移；翻 on 改保供四色，须专员重核黄金基准+签字）
SC8_NET_INVENTORY=off

# ── 携客云 SRM（承诺交期，appKey+MD5 签名）──────────────────────────────────────
XKY_API_BASE=
XKY_APP_KEY=
XKY_APP_SECRET=
XKY_OWNER_COMPANY_CODE=
XKY_ERP_CODE=

# ── 企业微信（内部通知通道）─────────────────────────────────────────────────────
WECOM_WEBHOOK_URL=

# ── Claude API（CRM 草稿生成，可选；缺省降级模板）────────────────────────────────
ANTHROPIC_API_KEY=
