# 敏感配置文件 - 绝对不提交
.env
*.env.local
.env.*.local
# 含真实凭据的所有 .env 变体（如 .env.test 探测档、.env.prod）——一律不提交；
# 仅放行不含真实值的样例 .env.example（见下方 negation）
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# 所有运行时审计 JSONL — 含业务数据，绝不入库
**/*.jsonl

# 场景 reports/ 目录（运行时生成，不入库）
**/reports/

# 落库 sweep 计划任务的启动包装脚本——由 工具-注册落库sweep计划任务.ps1 在注册时
# 生成，内含本机 python.exe 绝对路径烘焙，机器相关、可随时重新生成，不入库。
0-学习与工具/run-commit-sweep.ps1

# 外部参考文档（用友 U9C OpenAPI 厂商归档等二进制/Office 文件，体量大，不入库；本地留作参考）
外部文档/
7-外部文档/

# 繁体字重复目录（Windows 大小写不敏感副产品，不入库）
4-数字員工/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
*.swp

# 本机专属脚本（写死个人路径，仅供本机 Windows 任务计划调用，不同环境不通用）
start-aibot-service-dev.ps1

# 销售域实时数据缓存（同步自 SalesMarketing/crm_data/dashboard_data.json，含客户线索联系方式，不入库）
1-转型规划/AI运营指挥中心/data/

# 共享文档编辑锁（协议〇.7，工具-共享文档编辑锁.py 生成，本机瞬时协作状态，不入库）
*.editlock
# #197：acquire 内部互斥标记（生命周期仅限单次 acquire 调用，正常即建即删，
# 意外遗留时也不应入库）
*.editlock.mutex
*.editlock.tmp.*
# #225：acquire 时存的目标文件快照（release 时用于 diff 出本次持锁期间
# 新增/修改的行），本机瞬时协作状态，不入库
*.editlock.snapshot

# #226：需 Shao Peishen 决策项每日提醒计划任务的启动包装，由
# register-decision-reminder-task.ps1 在注册时机械生成（写死本机账户的
# 绝对路径），同 start-aibot-service-dev.ps1 一样本机专属、不同环境不通用
run-decision-reminder-check.ps1
